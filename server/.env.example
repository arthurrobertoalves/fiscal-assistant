# Copie para .env e ajuste. Nunca versione o arquivo .env com credenciais reais.

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3001

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

# Conexão com PostgreSQL (o docker-compose da raiz expõe o banco na porta 5440)
DATABASE_URL="postgresql://fiscal:fiscal@localhost:5440/fiscal_assistant?schema=public"

# Segredo de assinatura dos access tokens (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validade do access token em segundos (60 a 3600) e do refresh token em dias (1 a 90)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# true apenas atrás de proxy confiável (ex.: Render), para o rate limit usar o IP real
TRUST_PROXY=false

# Banco exclusivo para testes de integração (o nome deve terminar em _test)
TEST_DATABASE_URL="postgresql://fiscal:fiscal@localhost:5440/fiscal_assistant_test?schema=public"

# Pasta dos arquivos enviados (fora do repositório)
STORAGE_DIR=./storage

# Limite de tamanho de cada upload, em MB (1 a 50)
MAX_UPLOAD_MB=10

# IA (Groq). Sem a chave, a análise e o chat funcionam sem IA.
# ATENÇÃO: com a IA ativa, o conteúdo dos documentos é enviado ao Groq (ver docs/ARQUITETURA.md, seção 12.3).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tempo máximo de cada chamada à IA, em milissegundos
AI_TIMEOUT_MS=30000
